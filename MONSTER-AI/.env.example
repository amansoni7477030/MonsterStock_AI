# MONSTER AI configuration. Copy to .env (local) or /etc/monster-ai/monster.env (server, mode 600).
# Only the Telegram values are required; every other setting has a safe default.


# ---- Runtime ---------------------------------------------------------------
# Runtime environment.
MONSTER_ENV=production
# shadow = research output only (default, mandatory until a live shadow record exists). The system never places orders in either mode.
MONSTER_MODE=shadow
# DEBUG / INFO / WARNING / ERROR. DEBUG adds one line per HTTP request and per skipped fetch.
LOG_LEVEL=INFO
# text = one readable line per record; json = one JSON object per line (for log shippers).
LOG_FORMAT=text
# Code root (auto-detected).
MONSTER_HOME=
# Writable state: SQLite DB, models, cache, backups. Server: /var/lib/monster-ai.
MONSTER_DATA_DIR=
# Daily log files (<role>-YYYY-MM-DD.log plus errors-YYYY-MM-DD.log). Server: /var/log/monster-ai.
MONSTER_LOG_DIR=
# SQLite database file.
MONSTER_DB_PATH=
# Approved model artifacts.
MONSTER_MODELS_DIR=
# Disposable cache (size-limited).
MONSTER_CACHE_DIR=
# Database backups.
MONSTER_BACKUP_DIR=
# Time zone of log stamps and operator-facing displays; always printed with an explicit UTC offset. The server's own zone is never used, exchange logic is always IST and storage is always UTC.
MONSTER_TIMEZONE=Asia/Kolkata

# ---- Telegram --------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Destination chat id (run `python -m app.cli telegram-setup` to discover it automatically).
TELEGRAM_CHAT_ID=
# Chat for operational alerts (defaults to TELEGRAM_CHAT_ID).
TELEGRAM_ALERT_CHAT_ID=
# Also send the 08:45 preliminary scan (off by default to avoid noise).
SEND_PRELIM_REPORT=false
# Send the post-session evaluation summary.
SEND_EVENING_REPORT=true
# HTTP timeout per Telegram call.
TELEGRAM_TIMEOUT_SEC=20
# Bounded retries per message.
TELEGRAM_MAX_ATTEMPTS=5

# ---- Universe --------------------------------------------------------------
# Instrument universe policy.
UNIVERSE_MODE=fno_nifty100
# Symbols for UNIVERSE_MODE=custom (comma separated).
UNIVERSE_SYMBOLS=
# Hard cap on universe size (RAM guard).
UNIVERSE_MAX_SIZE=260
# Liquidity gate: minimum 20-day median traded value in INR crore.
MIN_MEDIAN_TURNOVER_CR=25
# Liquidity gate: minimum last close in INR.
MIN_PRICE=50
# Years of daily history to backfill.
HISTORY_YEARS=10
# Years of history used when training.
TRAIN_YEARS=6

# ---- Targets ---------------------------------------------------------------
# Intraday range thresholds in % of open.
RANGE_THRESHOLDS=1,2,3,5
# Threshold (%) whose calibrated probability drives the ranking.
PRIMARY_THRESHOLD=3
# Volatility-adjusted threshold: range > k x trailing mean range.
UNUSUAL_K=1.5
# Number of candidates reported.
TOP_N=5
# Calibrated P(range > primary) for STRONG.
TIER_STRONG_P=0.55
# Calibrated P for MODERATE.
TIER_MODERATE_P=0.40
# Calibrated P for WATCH; below this a name is not listed.
TIER_WATCH_P=0.25
# Fallback uncertainty ceiling for STRONG, used only for a model with no learned reference (trained models use the median uncertainty of held-out names of similar probability).
MAX_UNCERTAINTY_STRONG=0.35
# Fallback uncertainty ceiling for MODERATE (trained models use the 85th percentile of those names).
MAX_UNCERTAINTY_MODERATE=0.55
# Reject candidates whose round-trip cost exceeds this share of the median expected range.
MAX_COST_TO_RANGE_RATIO=0.25

# ---- Schedule --------------------------------------------------------------
# Preliminary scan (IST).
PRELIM_SCAN_TIME=08:45
# Final scan start (IST); must be after the pre-open equilibrium price is published (~09:08).
FINAL_SCAN_TIME=09:08:45
# Point-in-time cutoff of the final snapshot (IST).
REPORT_CUTOFF_TIME=09:12:00
# Hard deadline: the report is never sent after this time (IST).
REPORT_DEADLINE_TIME=09:14:30

# ---- Providers -------------------------------------------------------------
# Minimum spacing between Yahoo requests.
YAHOO_MIN_INTERVAL_SEC=1.0
# Minimum spacing between NSE requests.
NSE_MIN_INTERVAL_SEC=1.0
# Use NSE public endpoints (pre-open, filings).
NSE_ENABLED=true
# Default HTTP read timeout.
HTTP_TIMEOUT_SEC=30
# Bounded attempts per request.
HTTP_MAX_ATTEMPTS=4
# Abort responses larger than this (RAM guard).
HTTP_MAX_RESPONSE_MB=40
# HTTP client for scraped providers (NSE, Yahoo, RSS, GDELT): auto = curl_cffi (real browser TLS / HTTP-2 fingerprint, fewer blocks) with an automatic requests fallback.
HTTP_TRANSPORT=auto
# Browser profile curl_cffi impersonates: chrome, safari, firefox, edge or a pinned version such as chrome131 (empty = no impersonation). Proxies: set HTTPS_PROXY in the environment file.
HTTP_IMPERSONATE=chrome
# Use the GDELT DOC API for global news discovery.
GDELT_ENABLED=true
# RSS/Atom feed registry.
NEWS_FEEDS_FILE=
# How far back a collection run looks.
NEWS_LOOKBACK_HOURS=36
# Raw article text retention (structured events are kept).
NEWS_RETENTION_DAYS=45

# ---- LLM -------------------------------------------------------------------
# Groq API key (https://console.groq.com/keys). Enables LLM event extraction on Groq with the defaults below. Empty = deterministic rules only.
GROQ_API_KEY=
# Optional: another OpenAI-compatible base URL (e.g. https://api.openai.com/v1). Default with GROQ_API_KEY: https://api.groq.com/openai/v1.
LLM_API_BASE=
# Optional: API key for LLM_API_BASE (Groq uses GROQ_API_KEY).
LLM_API_KEY=
# Optional: model for structured extraction (default on Groq: openai/gpt-oss-120b).
LLM_MODEL=
# Optional: model used when the primary one is rate-limited or unavailable (default on Groq: openai/gpt-oss-20b; Groq's limits are per model, so it also adds headroom).
LLM_FALLBACK_MODEL=
# Reasoning effort for reasoning models such as gpt-oss (low = fast and cheap, enough for extraction). Empty = not sent.
LLM_REASONING_EFFORT=low
# LLM request timeout.
LLM_TIMEOUT_SEC=40
# Cost cap: articles sent to the LLM per news job (a job drains a backlog in up to four batches that share it).
LLM_MAX_ARTICLES_PER_RUN=60
# Wall-clock cap on the LLM calls of one news job (the rest of the job uses the rules), so rate limits can never delay the morning schedule.
LLM_MAX_SECONDS_PER_RUN=240
# Max tokens per extraction response (reasoning models spend part of it on thinking).
LLM_MAX_OUTPUT_TOKENS=1200
# Let the Groq gpt-oss model check a news item on the web (Groq's built-in browser_search tool) before it is judged: do independent outlets report the same facts, did anyone deny it, is it old news. Only for company news that matters and is not first-hand (never exchange filings), only on Groq with a gpt-oss model, never part of a backtest. It bills extra tokens and a search fee, and needs a plan with a large per-minute token limit (the free tier's 8K TPM is too small): when it fails the item is judged without it. false = off.
LLM_WEB_SEARCH=true
# Cost cap: web checks per news job (a job drains a backlog in up to four batches that share it). 0 = off.
LLM_WEB_MAX_PER_RUN=8

# ---- Jev -------------------------------------------------------------------
# TypeSafe API key (https://console.typesafe.ai/keys). Enables Jev judgments on news (event type, rumour, denial, severity, direction) with calibrated probabilities. Empty = rules (and the LLM) only.
TYPESAFE_API_KEY=
# Jev model id. A versioned id keeps the confidence thresholds valid; the alias jev-latest moves with releases.
JEV_MODEL=jev-1.14.0
# Jev request timeout.
JEV_TIMEOUT_SEC=20
# Cost cap: news items judged by Jev per news job (a job drains a backlog in up to four batches that share it).
JEV_MAX_ITEMS_PER_RUN=200
# A Jev answer is used only when its confidence reaches this value (0-1; below it the rules decide).
JEV_MIN_CONFIDENCE=0.5

# ---- Training --------------------------------------------------------------
# local-light = small capped training on the server; external = only pull signed artifacts; disabled.
TRAINING_MODE=local-light
# HTTPS URL of the external manifest.json (external mode).
MODEL_ARTIFACT_URL=
# HMAC-SHA256 key shared with the training worker.
MODEL_SIGNING_KEY=
# Row cap for in-process training (RAM guard).
TRAIN_MAX_ROWS=320000
# Min out-of-time days before a model may be called validated.
GATE_MIN_DAYS=120
# Calibration gate (expected calibration error).
GATE_MAX_ECE=0.06
# Brier skill vs climatology required.
GATE_MIN_BRIER_SKILL=0.0

# ---- Storage ---------------------------------------------------------------
# Daily backups retained.
BACKUP_KEEP_DAILY=7
# Weekly backups retained.
BACKUP_KEEP_WEEKLY=4
# Size budget of the local backup folder: the oldest backups beyond the daily / weekly policy are dropped until it fits (the newest is always kept). 0 = no budget.
BACKUP_MAX_MB=1500
# Size budget of the whole data directory (database, models, backups, cache). Above 80 % health warns; above 100 % the optional data is trimmed harder. 0 = no budget.
DATA_MAX_MB=4000
# Structured news events are kept this long (about 3 years). 0 = forever.
EVENT_RETENTION_DAYS=1100
# Pre-open / live quote rows are kept this long. Intermediate pre-open polls are thinned to the last one per symbol and day after 14 days. 0 = forever.
QUOTE_RETENTION_DAYS=400
# Frozen snapshots, predictions, outcomes and evaluation metrics are kept this long (5 years). 0 = forever.
RECORD_RETENTION_DAYS=1825
# Job runs, delivery records and undelivered alerts are kept this long (delivered alerts half of it). 0 = forever.
OPS_RETENTION_DAYS=180
# Daily log files older than this are deleted (the journal keeps its own two-week window). Minimum 1.
LOG_RETENTION_DAYS=30
# Size budget of the whole log directory; the oldest files go first, today's files are never removed. 0 = no budget.
LOG_MAX_MB=150
# If set, backups are gpg-encrypted (AES256).
BACKUP_PASSPHRASE=
# S3-compatible endpoint (AWS, R2, B2, MinIO, Spaces).
S3_ENDPOINT_URL=
# Bucket for off-box backups / cold archive / artifacts.
S3_BUCKET=
# Signing region ('auto' for Cloudflare R2).
S3_REGION=us-east-1
# S3 access key id.
S3_ACCESS_KEY_ID=
# S3 secret key.
S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket.
S3_PREFIX=monster-ai/

# ---- Dashboard -------------------------------------------------------------
# Run the optional read-only dashboard service.
DASHBOARD_ENABLED=false
# Bind address. Keep loopback and use an SSH tunnel.
DASHBOARD_HOST=127.0.0.1
# Dashboard port.
DASHBOARD_PORT=8080
# Bearer token (required when not bound to loopback).
DASHBOARD_TOKEN=

# ---- Resources -------------------------------------------------------------
# Warn below this free disk.
MIN_FREE_DISK_MB_WARN=1500
# Critical: emergency cleanup, block heavy jobs.
MIN_FREE_DISK_MB_CRIT=600
# Do not start heavy jobs below this MemAvailable.
MIN_AVAILABLE_RAM_MB=120
# Soft RSS ceiling per job process (watchdog aborts the job).
JOB_MAX_RSS_MB=720
# Default wall-clock limit for non-critical jobs.
JOB_TIMEOUT_MINUTES=60
