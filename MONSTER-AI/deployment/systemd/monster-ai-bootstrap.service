# ======================================================================================================
# MONSTER AI - first-run bootstrap                           (/etc/systemd/system/monster-ai-bootstrap.service)
#
# WHAT IT DOES
#   Runs `python -m app.cli bootstrap --resume`: init -> universe -> history backfill -> F&O backfill ->
#   initial model training -> smoke scan -> "installation complete" Telegram message. It takes 10-60
#   minutes, is resumable and idempotent (progress is the kv key bootstrap.state: running | done | failed).
#   deployment/install.sh starts it with `systemctl start --no-block`, so it survives an SSH disconnect.
#   It is not enabled at boot: the daemon re-launches the bootstrap by itself when it never completed.
#
# SELF-HEALING
#   A failed run is retried after 5 minutes (Restart=on-failure, RestartSec=300). The retries are bounded
#   (StartLimitBurst=6 within 6 hours); when they are used up the unit enters "failed" and OnFailure=
#   sends a Telegram alert with the last journal lines. The daemon keeps trying independently.
#
# RESOURCES
#   Same memory ceiling as the daemon (MemoryHigh=750M / MemoryMax=880M) but the lowest CPU and I/O
#   priority (Nice=10, IOSchedulingClass=idle) so the 09:12 IST report path is never starved.
#
# SECURITY: identical sandbox to monster-ai.service (see there for the reasoning).
# ======================================================================================================

[Unit]
Description=MONSTER AI initial bootstrap (universe, history backfill, first models)
Documentation=file:/opt/monster-ai/deployment/README.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
OnFailure=monster-ai-alert@%n.service
# Bounded retries: at most 6 starts within 6 hours.
StartLimitIntervalSec=6h
StartLimitBurst=6

[Service]
Type=oneshot
RemainAfterExit=yes
User=monster
Group=monster
WorkingDirectory=/opt/monster-ai
SyslogIdentifier=monster-ai-bootstrap

EnvironmentFile=/etc/monster-ai/monster.env
Environment=MONSTER_ENV=production
Environment=MONSTER_HOME=/opt/monster-ai
Environment=MONSTER_DATA_DIR=/var/lib/monster-ai
Environment=MONSTER_LOG_DIR=/var/log/monster-ai
Environment=MONSTER_ENV_FILE=/etc/monster-ai/monster.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1

ExecStart=/opt/monster-ai/.venv/bin/python -m app.cli bootstrap --resume
TimeoutStartSec=infinity
TimeoutStopSec=90
Restart=on-failure
RestartSec=300
KillMode=control-group
OOMPolicy=continue
Nice=10
IOSchedulingClass=idle
MemoryHigh=750M
MemoryMax=880M
TasksMax=256
LimitNOFILE=4096
UMask=0027

StateDirectory=monster-ai
StateDirectoryMode=0750
LogsDirectory=monster-ai
LogsDirectoryMode=0750

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/monster-ai /var/log/monster-ai
ReadOnlyPaths=/opt/monster-ai /etc/monster-ai
